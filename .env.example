# Absolute path to wg binary
WG_BINARY=/usr/bin/wg

# Absolute path to iproute2 ip command
IP_BINARY=/usr/bin/ip

# API key protecting all /api/v1 calls from unauthorized clients
API_KEY=changeme

# Wireguard interface managed by this API
MANAGED_INTERFACE=wg-server

# Disable the configuration of any interfaces, useful for development
#DRY_RUN=true

# Directory to store cached Wireguard server configurations in, must already exist
CONFIGURATION_CACHE_DIR=cache

# Connection to control server endpoint
CONTROL_SERVER_URI=http://localhost:8000/api/v1/
CONTROL_SERVER_AUTHKEY=changeme
#CONTROL_SERVER_TIMEOUT=5